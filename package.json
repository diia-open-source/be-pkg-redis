{
    "name": "@diia-inhouse/redis",
    "version": "3.2.75",
    "description": "Redis services - redlock, pubsub, cache and store",
    "license": "SEE LICENCE IN LICENCE.md",
    "author": "diia-team",
    "repository": "https://github.com/diia-open-source/be-pkg-redis",
    "files": [
        "dist"
    ],
    "type": "module",
    "main": "dist/index.js",
    "types": "dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "default": "./dist/index.js"
        },
        "./package.json": "./package.json"
    },
    "scripts": {
        "prebuild": "rimraf dist",
        "build": "tsdown",
        "semantic-release": "semantic-release",
        "start": "npm run build && node dist/index.js",
        "lint": "oxlint && oxfmt --check .",
        "lint-fix": "oxlint --fix && oxfmt .",
        "lint:lockfile": "lockfile-lint --path package-lock.json --allowed-hosts registry.npmjs.org --validate-https",
        "prepare": "npm run build",
        "test": "vitest run",
        "test:watch": "vitest watch"
    },
    "dependencies": {
        "ioredis": "5.10.1",
        "redis-semaphore": "5.7.0"
    },
    "devDependencies": {
        "@diia-inhouse/configs": "7.5.0",
        "@diia-inhouse/diia-logger": "4.7.69",
        "@diia-inhouse/env": "3.3.121",
        "@diia-inhouse/errors": "2.3.51",
        "@diia-inhouse/oxc-config": "6.2.2",
        "@diia-inhouse/test": "8.4.17",
        "@diia-inhouse/types": "14.13.3",
        "@diia-inhouse/validators": "2.3.2",
        "@types/node": "25.6.2",
        "@vitest/coverage-v8": "4.1.11",
        "@vitest/ui": "4.1.11",
        "lockfile-lint": "5.0.0",
        "oxfmt": "0.74.0",
        "oxlint": "1.89.0",
        "oxlint-tsgolint": "7.0.2004",
        "rimraf": "6.1.3",
        "semantic-release": "25.0.3",
        "tsdown": "0.22.0",
        "typescript": "5.9.3",
        "vitest": "4.1.11",
        "vitest-mock-extended": "4.0.0"
    },
    "peerDependencies": {
        "@diia-inhouse/env": ">=3.0.0",
        "@diia-inhouse/errors": ">=2.0.0",
        "@diia-inhouse/types": ">=13.0.0",
        "@diia-inhouse/validators": ">=2.0.0"
    },
    "commitlint": {
        "extends": "@diia-inhouse/configs/dist/commitlint"
    },
    "release": {
        "extends": "@diia-inhouse/configs/dist/semantic-release/package"
    },
    "engines": {
        "node": ">=24"
    }
}
